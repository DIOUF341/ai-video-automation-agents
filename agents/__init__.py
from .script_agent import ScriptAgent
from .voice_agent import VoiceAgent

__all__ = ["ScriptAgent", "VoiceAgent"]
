"""API FastAPI principale."""
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse

from app.config import settings
from app.schemas import (
    ScriptGenerationRequest,
    ScriptGenerationResponse,
    VoiceGenerationRequest,
    VoiceGenerationResponse,
)
from agents.script_agent import ScriptAgent
from agents.voice_agent import VoiceAgent

app = FastAPI(
    title=settings.app_name,
    description="Plateforme d'automatisation de création de vidéos assistée par IA",
    version="0.1.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/")
def read_root() -> dict:
    return {
        "status": "ok",
        "app": settings.app_name,
        "message": "Le générateur de script IA est prêt.",
        "version": "0.1.0",
    }


@app.get("/health")
def health_check() -> dict:
    return {
        "status": "healthy",
        "service": settings.app_name,
    }


@app.post("/api/generate-script", response_model=ScriptGenerationResponse)
def generate_script(payload: ScriptGenerationRequest) -> ScriptGenerationResponse:
    try:
        agent = ScriptAgent(
            api_key=settings.openai_api_key,
            model=settings.openai_model,
        )
        script = agent.generate(
            prompt=payload.prompt,
            duration=payload.duration,
            style=payload.style,
            language=payload.language,
        )
        return ScriptGenerationResponse(**script)
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Erreur interne: {str(e)}")


@app.post("/api/generate-voice", response_model=VoiceGenerationResponse)
def generate_voice(payload: VoiceGenerationRequest) -> VoiceGenerationResponse:
    try:
        voice_agent = VoiceAgent(output_dir="output")

        if payload.script:
            result = voice_agent.generate_from_script(
                script=payload.script,
                output_name=payload.output_name,
                language=payload.language,
            )
        else:
            if not payload.text:
                raise ValueError("Le texte du message vocal est obligatoire.")
            result = voice_agent.generate(
                text=payload.text,
                language=payload.language,
                output_name=payload.output_name,
            )

        return VoiceGenerationResponse(**result)
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Erreur interne: {str(e)}")


@app.exception_handler(Exception)
async def global_exception_handler(_, exc: Exception):
    return JSONResponse(
        status_code=500,
        content={"detail": str(exc), "error_type": type(exc).__name__},
    )


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)

